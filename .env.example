# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (optional, defaults to localhost:3000 in development)
# NEXT_PUBLIC_SITE_URL=https://baovietweb.site

# AI chat VNR202 (OpenRouter, chỉ dùng phía máy chủ)
OPENROUTER_API_KEY=your_openrouter_api_key
# Tùy chọn: danh sách model, phân cách bằng dấu phẩy (model đầu tiên được ưu tiên)
# OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
